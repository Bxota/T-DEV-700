name: Backend CI (dev compose + tests)

on:
  push:
    branches: [ dev ]
  pull_request:

jobs:
  backend-tests:
    runs-on: ubuntu-latest

    permissions:
      contents: read
      actions: read
      checks: write
      pull-requests: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Show Docker Compose version
        run: docker compose version

      - name: Fail if required vars/secrets are missing
        run: |
          set -e
          # root .env (vars)
          [ -n "${{ vars.PROJECT_NAME }}" ] || (echo "Missing vars.PROJECT_NAME" && exit 1)
          [ -n "${{ vars.ENV }}" ] || (echo "Missing vars.ENV" && exit 1)
          [ -n "${{ vars.PYTHON_VERSION }}" ] || (echo "Missing vars.PYTHON_VERSION" && exit 1)
          [ -n "${{ vars.NODE_VERSION }}" ] || (echo "Missing vars.NODE_VERSION" && exit 1)
          [ -n "${{ vars.POSTGRES_VERSION }}" ] || (echo "Missing vars.POSTGRES_VERSION" && exit 1)
          [ -n "${{ vars.NGX_VERSION }}" ] || (echo "Missing vars.NGX_VERSION" && exit 1)
          [ -n "${{ vars.PORT_DB }}" ] || (echo "Missing vars.PORT_DB" && exit 1)
          [ -n "${{ vars.PORT_BACK }}" ] || (echo "Missing vars.PORT_BACK" && exit 1)
          [ -n "${{ vars.PORT_FRONT }}" ] || (echo "Missing vars.PORT_FRONT" && exit 1)
          [ -n "${{ vars.PORT_NGX }}" ] || (echo "Missing vars.PORT_NGX" && exit 1)
          [ -n "${{ vars.POSTGRES_DB }}" ] || (echo "Missing vars.POSTGRES_DB" && exit 1)
          # secrets
          [ -n "${{ secrets.POSTGRES_USER }}" ] || (echo "Missing secrets.POSTGRES_USER" && exit 1)
          [ -n "${{ secrets.POSTGRES_PASSWORD }}" ] || (echo "Missing secrets.POSTGRES_PASSWORD" && exit 1)
          # optional but recommended as secret
          [ -n "${{ secrets.DJANGO_SECRET_KEY }}" ] || (echo "Missing secrets.DJANGO_SECRET_KEY" && exit 1)
          # frontend env (vars)
          [ -n "${{ vars.VITE_API_BASE }}" ] || (echo "Missing vars.VITE_API_BASE" && exit 1)
          [ -n "${{ vars.VITE_APP_ENV }}" ] || (echo "Missing vars.VITE_APP_ENV" && exit 1)

      - name: Generate project .env (runtime only)
        run: |
          : > .env
          {
            echo "PROJECT_NAME=${{ vars.PROJECT_NAME }}"
            echo "ENV=${{ vars.ENV }}"
            echo "PYTHON_VERSION=${{ vars.PYTHON_VERSION }}"
            echo "NODE_VERSION=${{ vars.NODE_VERSION }}"
            echo "POSTGRES_VERSION=${{ vars.POSTGRES_VERSION }}"
            echo "NGX_VERSION=${{ vars.NGX_VERSION }}"
            echo "PORT_DB=${{ vars.PORT_DB }}"
            echo "PORT_BACK=${{ vars.PORT_BACK }}"
            echo "PORT_FRONT=${{ vars.PORT_FRONT }}"
            echo "PORT_NGX=${{ vars.PORT_NGX }}"
            echo "POSTGRES_DB=${{ vars.POSTGRES_DB }}"
            echo "POSTGRES_USER=${{ secrets.POSTGRES_USER }}"
            echo "POSTGRES_PASSWORD=${{ secrets.POSTGRES_PASSWORD }}"
            echo "CI=1"
          } >> .env

      - name: Generate backend/.env.dev (runtime only)
        run: |
          mkdir -p backend
          cat > backend/.env.dev <<EOF
DJANGO_SETTINGS_MODULE=core.settings
DEBUG=True
SECRET_KEY=${{ secrets.DJANGO_SECRET_KEY }}
DATABASE_URL=postgres://${{ secrets.POSTGRES_USER }}:${{ secrets.POSTGRES_PASSWORD }}@db:${{ vars.PORT_DB }}/${{ vars.POSTGRES_DB }}
ALLOWED_HOSTS=localhost,127.0.0.1
EOF

      - name: Generate frontend/.env.dev (runtime only)
        run: |
          mkdir -p frontend
          cat > frontend/.env.dev <<EOF
VITE_API_BASE=${{ vars.VITE_API_BASE }}
VITE_APP_ENV=${{ vars.VITE_APP_ENV }}
EOF

      - name: Start database
        run: |
          docker compose -f docker-compose.yml up -d db
          echo "Waiting for Postgres to become healthy..."
          for i in {1..30}; do
            if docker compose -f docker-compose.yml exec -T db pg_isready -U "${{ secrets.POSTGRES_USER }}" -d "${{ vars.POSTGRES_DB }}" -h localhost; then
              echo "Postgres is ready."
              break
            fi
            sleep 2
          done

      - name: Start backend (dev)
        run: docker compose -f docker-compose.yml up -d backend

      - name: Run backend tests with pytest (inside container)
        run: |
          docker compose -f docker-compose.yml exec -T backend \
            pytest -q \
              --junitxml=/app/junit.xml \
              --cov=/app \
              --cov-report=xml:/app/coverage.xml \
              --cov-report=html:/app/htmlcov

      - name: Upload JUnit report
        uses: actions/upload-artifact@v4
        with:
          name: junit
          path: backend/junit.xml

      - name: Upload coverage (XML + HTML)
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: |
            backend/coverage.xml
            backend/htmlcov

      - name: Teardown and secure cleanup
        if: always()
        run: |
          docker compose -f docker-compose.yml down -v
          shred -u .env || true
          shred -u backend/.env.dev || true
          shred -u frontend/.env.dev || true
